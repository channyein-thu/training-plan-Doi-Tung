# Backend configuration template. Copy to `app.env` and fill in real values.
# `app.env` is gitignored and must NEVER be committed or baked into an image.
#
# In docker-compose several of these are overridden by the `backend` service's
# `environment:` block (GO_ENV, PORT, MYSQL_HOST/PORT/DB/USER/PASSWORD,
# ALLOWED_ORIGINS, GOOGLE_REDIRECT_URL) — see docker-compose.yml.

# ---- Database ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=training_plan_db
MYSQL_USER=change_me
MYSQL_PASSWORD=change_me

# ---- Uploads ----
UPLOAD_PATH=./uploads

# ---- Auth ----
# Generate a strong value, e.g.  openssl rand -base64 48
# Startup FAILS if this is missing or shorter than 32 characters.
JWT_SECRET=

# ---- Environment / seeding ----
# Set to "development" ONLY in local dev to enable the admin seeder.
# Leave as "production" (or anything non-development) in production.
GO_ENV=production
# Only used when GO_ENV=development; no seed happens if empty.
ADMIN_SEED_PASSWORD=

# ---- Server ----
PORT=8080
# Comma-separated front-end origins allowed by CORS, e.g.
# https://admin.yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ---- Google OAuth2 ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# ---- Google Calendar ----
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_CALENDAR_ID=
TIMEZONE=Asia/Bangkok

# ---- Web Push (VAPID) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@yourdomain.com
