# docker-compose interpolation values. Copy to `.env` and fill in.
# `.env` holds secrets — keep it out of git.

# ---- Domains (point their DNS A/AAAA records at this server) ----
API_DOMAIN=api.yourdomain.com      # backend
APP_DOMAIN=app.yourdomain.com      # manager/staff web
ADMIN_DOMAIN=admin.yourdomain.com  # admin web

# ---- TLS ----
# Contact email for Let's Encrypt certificate notifications.
TLS_EMAIL=ops@yourdomain.com

# ---- Database ----
# Used by both the `db` service and injected into the `backend` service.
MYSQL_DB=training_plan_db
MYSQL_USER=training_user
MYSQL_PASSWORD=change_me_strong
MYSQL_ROOT_PASSWORD=change_me_strong_root
